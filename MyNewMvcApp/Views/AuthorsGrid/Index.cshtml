@model IEnumerable<ProgramacionAvanzada.Books.Model.Author>

@{
    ViewData["Title"] = "Authors Grid";
}

<h1>Authors Grid</h1>

<form asp-action="Index" method="get" class="mb-4">
    <div class="row">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text" name="searchName" class="form-control" placeholder="Search by author name..." value="@ViewBag.SearchName" />
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </div>
    </div>
</form>

@if (Model != null && Model.Any())
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Country</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var author in Model)
            {
                <tr>
                    <td>@author.Id</td>
                    <td>@author.Name</td>
                    <td>@author.Country</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@author.Id" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="Edit" asp-route-id="@author.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@author.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else if (!string.IsNullOrEmpty(ViewBag.SearchName))
{
    <div class="alert alert-info">No authors found matching "@ViewBag.SearchName".</div>
}
else
{
    <div class="alert alert-info">Enter a name to search for authors.</div>
}
