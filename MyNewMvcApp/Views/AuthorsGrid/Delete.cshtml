@model ProgramacionAvanzada.Books.Model.Author

@{
    ViewData["Title"] = "Delete Author";
}

<h1>Delete Author</h1>

<h3 class="text-danger">Are you sure you want to delete this author?</h3>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Country</dt>
            <dd class="col-sm-9">@(Model.Country ?? "N/A")</dd>

            @if (Model.Books != null && Model.Books.Any())
            {
                <dt class="col-sm-3">Books</dt>
                <dd class="col-sm-9">
                    <ul>
                        @foreach (var book in Model.Books)
                        {
                            <li>@book.OriginalTitle</li>
                        }
                    </ul>
                </dd>
            }
        </dl>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mt-3">@TempData["Error"]</div>
}

<div class="mt-3">
    <form asp-action="Delete" method="post" style="display: inline;">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</div>
