@{
    ViewData["Title"] = "Book Copies Statistics";
}

<div class="container mt-5">
    <h1 class="mb-4">Book Copies Statistics</h1>
    
    <div class="row">
        <div class="col-md-4">
            <div class="card text-white bg-primary mb-3">
                <div class="card-header">Total Book Copies</div>
                <div class="card-body">
                    <h2 class="card-title" id="totalCopies">@ViewBag.TotalCopies</h2>
                    <p class="card-text">Total number of book copies in the library</p>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card text-white bg-danger mb-3">
                <div class="card-header">Lost Books</div>
                <div class="card-body">
                    <h2 class="card-title" id="lostCopies">@ViewBag.LostCopies</h2>
                    <p class="card-text">Books marked as lost</p>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card text-white bg-success mb-3">
                <div class="card-header">Available Books</div>
                <div class="card-body">
                    <h2 class="card-title" id="availableCopies">@ViewBag.AvailableCopies</h2>
                    <p class="card-text">Books currently available</p>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-info mt-4" role="alert">
        <strong>Real-time Updates:</strong> This page updates automatically when book copies are added, modified, or removed.
        <span id="connectionStatus" class="badge bg-secondary">Connecting...</span>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4>Lost Books by Hour - Today (<span id="currentDate"></span>)</h4>
                </div>
                <div class="card-body">
                    <canvas id="lostBooksChart" height="80"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        // Set current date
        document.getElementById("currentDate").innerText = new Date().toLocaleDateString();

        // Initialize Chart.js
        let lostBooksChart = null;
        const ctx = document.getElementById('lostBooksChart').getContext('2d');
        const currentHour = new Date().getHours();

        async function loadChartData() {
            try {
                const response = await fetch('/api/BookCopies/lost-hourly-today');
                const hourlyData = await response.json();
                initializeChart(hourlyData);
            } catch (error) {
                console.error('Error loading chart data:', error);
            }
        }

        function initializeChart(data) {
            const labels = Array.from({ length: 24 }, (_, i) => i + ':00');
            
            // Create background colors - highlight current hour
            const backgroundColors = Array.from({ length: 24 }, (_, i) => 
                i === currentHour ? 'rgba(255, 99, 132, 0.8)' : 'rgba(54, 162, 235, 0.6)'
            );

            const chartConfig = {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Lost Books',
                        data: data,
                        borderColor: 'rgb(220, 53, 69)',
                        backgroundColor: 'rgba(220, 53, 69, 0.1)',
                        fill: true,
                        tension: 0.3,
                        pointBackgroundColor: backgroundColors,
                        pointBorderColor: backgroundColors,
                        pointRadius: 5,
                        pointHoverRadius: 7
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top'
                        },
                        title: {
                            display: false
                        },
                        tooltip: {
                            callbacks: {
                                title: function(context) {
                                    const hour = context[0].label;
                                    const isCurrent = context[0].dataIndex === currentHour;
                                    return hour + (isCurrent ? ' (Current Hour)' : '');
                                },
                                label: function(context) {
                                    return 'Lost Books: ' + context.parsed.y;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                stepSize: 1,
                                precision: 0
                            },
                            title: {
                                display: true,
                                text: 'Number of Lost Books'
                            }
                        },
                        x: {
                            title: {
                                display: true,
                                text: 'Hour of Day'
                            }
                        }
                    }
                }
            };

            if (lostBooksChart) {
                lostBooksChart.destroy();
            }
            lostBooksChart = new Chart(ctx, chartConfig);
        }

        function updateChart(data) {
            if (lostBooksChart) {
                lostBooksChart.data.datasets[0].data = data;
                
                // Update point colors to highlight current hour
                const backgroundColors = Array.from({ length: 24 }, (_, i) => 
                    i === currentHour ? 'rgba(255, 99, 132, 0.8)' : 'rgba(54, 162, 235, 0.6)'
                );
                lostBooksChart.data.datasets[0].pointBackgroundColor = backgroundColors;
                lostBooksChart.data.datasets[0].pointBorderColor = backgroundColors;
                
                lostBooksChart.update('active');
            }
        }

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/bookCopiesStatsHub")
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveStatsUpdate", function (totalCopies, lostCopies) {
            console.log("Stats update received:", totalCopies, lostCopies);
            
            // Update the statistics on the page
            document.getElementById("totalCopies").innerText = totalCopies;
            document.getElementById("lostCopies").innerText = lostCopies;
            document.getElementById("availableCopies").innerText = totalCopies - lostCopies;
            
            // Add a visual feedback
            flashCards();
        });

        connection.on("ReceiveHourlyChartUpdate", function (hourlyData) {
            console.log("Hourly chart update received:", hourlyData);
            updateChart(hourlyData);
        });

        connection.onreconnecting(() => {
            document.getElementById("connectionStatus").className = "badge bg-warning";
            document.getElementById("connectionStatus").innerText = "Reconnecting...";
        });

        connection.onreconnected(() => {
            document.getElementById("connectionStatus").className = "badge bg-success";
            document.getElementById("connectionStatus").innerText = "Connected";
        });

        connection.onclose(() => {
            document.getElementById("connectionStatus").className = "badge bg-danger";
            document.getElementById("connectionStatus").innerText = "Disconnected";
        });

        connection.start()
            .then(() => {
                console.log("SignalR Connected");
                document.getElementById("connectionStatus").className = "badge bg-success";
                document.getElementById("connectionStatus").innerText = "Connected";
                
                // Load initial chart data
                loadChartData();
            })
            .catch(err => {
                console.error("SignalR Connection Error: ", err);
                document.getElementById("connectionStatus").className = "badge bg-danger";
                document.getElementById("connectionStatus").innerText = "Connection Failed";
            });

        function flashCards() {
            const cards = document.querySelectorAll('.card');
            cards.forEach(card => {
                card.style.transition = 'transform 0.3s';
                card.style.transform = 'scale(1.05)';
                setTimeout(() => {
                    card.style.transform = 'scale(1)';
                }, 300);
            });
        }
    </script>
}
